# ========== DATABASE (Neon Serverless PostgreSQL) ==========
# Get your connection string from: https://console.neon.tech
# Format: postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql+asyncpg://neondb_owner:your-password@ep-xxxx-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_ECHO=false

# ========== CLERK AUTH ==========
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxx

# ========== APP ==========
APP_NAME=EduStack
APP_ENV=development
SECRET_KEY=your-random-secret-key-here-min-32-chars
CORS_ORIGINS=http://localhost:3000

# ========== STORAGE (S3 / UploadThing) ==========
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# ========== RAZORPAY ==========
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxx

# ========== WHATSAPP (Twilio/Gupshup) ==========
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_FROM_NUMBER=

# ========== EMAIL (optional) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@edustack.in

# Resend transactional email.
# Never commit a real key. Rotate any key that was pasted into chat or logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=EduStack
# Set true only after the school's sender domain/email is verified in Resend.
RESEND_ALLOW_SCHOOL_FROM=false
RESEND_REPLY_TO_SCHOOL_EMAIL=true

# ========== OPENAI / AI FEATURES ==========
# Never commit a real key. All AI requests go through backend APIs only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_OCR_MODEL=gpt-5.4-mini
AI_DAILY_REQUEST_LIMIT=100
AI_PARENT_CHAT_DAILY_LIMIT=50
AI_OCR_MAX_FILE_MB=8

# ========== PDF / RECEIPTS ==========
RECEIPT_LOGO_URL=
SCHOOL_STAMP_URL=
